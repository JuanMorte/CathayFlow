# Copy to .env (gitignored) and fill in. No quotes, no spaces around "=".
# Real environment variables always beat this file (e.g. OFFLINE=1 make demo).

AWS_PROFILE=flow
AWS_REGION=ap-southeast-1
# From the flow-data stack output "BucketName"
FLOW_BUCKET=
FLOW_PARAM_PREFIX=/flow
# local | cloud | e2e: keeps replay snapshots apart
FLOW_STATE_ENV=local
OFFLINE=0

OAG_KEY_PROFILE=dev
OAG_MAX_CALLS=800
# Copy from the OAG portal's "Try it" page
OAG_CONNECTIONS_URL=
GOOGLE_MAX_CALLS=300

# Optional overrides. Leave empty to read the keys from SSM Parameter Store.
OAG_KEY_DEV=
OAG_KEY_DEMO=
OAG_CONNECTIONS_KEY_DEV=
OAG_CONNECTIONS_KEY_DEMO=
GOOGLE_ROUTES_KEY=
